# Runtime
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
JSON_BODY_LIMIT=256kb
TRUST_PROXY_HOPS=0

# Public origins and browser policy
PUBLIC_FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/api/v1/auth

# PostgreSQL
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/tech_interview_platform

# Access-token configuration (replace placeholders; never reuse these secrets)
JWT_ACCESS_ISSUER=http://localhost:3000
JWT_ACCESS_AUDIENCE=tech-interview-api
JWT_SIGNING_SECRET_BASE64=REPLACE_WITH_BASE64_ENCODED_32_BYTE_SECRET
RATE_LIMIT_HMAC_SECRET_BASE64=REPLACE_WITH_DIFFERENT_BASE64_ENCODED_32_BYTE_SECRET

# Assessment and progress policy
ASSESSMENT_SESSION_DURATION_HOURS=24
ASSESSMENT_MAX_QUESTION_COUNT=50
WEAK_AREA_MINIMUM_EVALUATED_QUESTIONS=5
WEAK_AREA_SCORE_THRESHOLD_PERCENTAGE=60

# Argon2id production baseline and bounded work admission
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
ARGON2_HASH_LENGTH=32
ARGON2_MAX_CONCURRENCY=1
ARGON2_QUEUE_LIMIT=16
ARGON2_QUEUE_TIMEOUT_MS=2000
