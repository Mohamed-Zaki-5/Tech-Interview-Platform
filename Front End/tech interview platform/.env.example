# Environment Configuration for Tech Interview Platform Frontend
# 
# Copy this file to .env or .env.local and fill in the appropriate values
# Vite automatically loads .env.local (but not .env) - use .env.local for development
# 
# IMPORTANT: Do NOT commit .env.local or .env with real secrets to version control
# Only .env.example should be committed

# API Configuration
# Base URL for backend API
# Examples:
#   Development:  http://localhost:5000
#   Staging:      https://api-staging.example.com
#   Production:   https://api.example.com
# 
# Leave empty to use relative URLs (same domain)
VITE_API_BASE_URL=

# Mode (automatically set by Vite)
# production or development
# Usually not needed - Vite sets this automatically
VITE_MODE=development

# Debug/Development Flags (optional)
# Enable verbose logging in development
# VITE_DEBUG=true
